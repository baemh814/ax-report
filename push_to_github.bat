@echo off
chcp 65001 > nul
title AX 트렌드 리포트 - GitHub 원클릭 업로드
echo ===================================================================
echo   [AX 트렌드 리포트] GitHub 원클릭 업로드 (Push)
echo ===================================================================
echo.
echo  GitHub 저장소 주소:
echo  https://github.com/baemh814/ax-report.git
echo.
echo  * 처음 업로드 시 브라우저에서 'GitHub 로그인/승인(Authorize)' 창이
echo    뜰 수 있습니다. [Authorize] 버튼만 눌러주시면 자동으로 완료됩니다!
echo ===================================================================
echo.

git push -u origin main

echo.
if %ERRORLEVEL% EQU 0 (
    echo ===================================================================
    echo  [성공] GitHub에 코드가 완벽하게 업로드되었습니다!
    echo  이제 저장소 Settings -^> Pages에서 웹사이트 주소를 활성화하세요.
    echo ===================================================================
) else (
    echo ===================================================================
    echo  [안내] 로그인이 필요하거나 오류가 발생했습니다.
    echo  위 메시지를 확인하시거나 창을 닫아주세요.
    echo ===================================================================
)
echo.
pause
